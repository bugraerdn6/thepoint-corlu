{
  "rules": {
    ".read": false,
    ".write": false,
    "pins": {
      "$h": {
        "$hash": {
          ".read": "auth != null",
          ".write": "(auth != null && !root.child('pins').child($h).exists()) && root.child('access').child(auth.uid).child('until').val() > now",
          ".validate": "newData.val() === true && $hash.length === 64"
        },
        ".write": "(root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true) && !newData.exists()"
      }
    },
    "links": {
      "$h": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.parent().parent().parent().child('pins').child($h).child(newData.val()).exists()"
        },
        ".write": "(root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true) && !newData.exists()"
      }
    },
    "players": {
      ".read": "auth != null && root.child('access').child(auth.uid).child('until').val() > now",
      ".indexOn": [
        "weekPts"
      ],
      "$h": {
        ".write": "(((auth != null && newData.parent().parent().child('links').child($h).child(auth.uid).exists()) && root.child('access').child(auth.uid).child('until').val() > now) && !root.child('bans').child($h).exists()) || ((root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true) && !newData.exists())",
        ".validate": "newData.hasChildren(['handle', 'visits', 'points', 'createdAt'])",
        "handle": {
          ".validate": "newData.isString() && newData.val().length <= 30 && (!data.exists() || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
        },
        "consentAt": {
          ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
        },
        "visits": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 0) || newData.val() === data.val() || (newData.val() === data.val() + 1 && newData.parent().child('lastVisit').val() === now && (!data.parent().child('lastVisit').exists() || data.parent().child('lastVisit').val() < now - 43200000)))"
        },
        "lastVisit": {
          ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
        },
        "points": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 0) || newData.val() === data.val() || (newData.val() > data.val() && newData.val() <= data.val() + 50 && newData.parent().child('lastPointAt').val() === now && (!data.parent().child('lastPointAt').exists() || data.parent().child('lastPointAt').val() < now - 15000)))"
        },
        "lastPointAt": {
          ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
        },
        "weekPts": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('points').val() && (!data.exists() || newData.val() <= data.val() + 50)"
        },
        "weekId": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "$other": {
          ".validate": false
        },
        "nick": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20"
        },
        "showIg": {
          ".validate": "newData.isBoolean()"
        },
        "invites": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "rooms": {
      ".read": "auth != null && root.child('access').child(auth.uid).child('until').val() > now",
      ".indexOn": [
        "createdAt"
      ],
      "$code": {
        ".write": "((auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)) && root.child('access').child(auth.uid).child('until').val() > now) || (root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true)",
        ".validate": "$code.length === 4 && newData.hasChildren(['game', 'hostHk', 'hostUid', 'state', 'visibility', 'createdAt']) && (data.exists() ? (newData.child('hostUid').val() === data.child('hostUid').val() && newData.child('hostHk').val() === data.child('hostHk').val()) : (!root.child('bans').child(newData.child('hostHk').val()).exists() && newData.child('hostUid').val() === auth.uid && root.child('links').child(newData.child('hostHk').val()).child(auth.uid).exists()))",
        "visibility": {
          ".validate": "newData.val() === 'private' || (newData.val() === 'public' && root.child('settings').child('crossTable').val() !== false)"
        },
        "state": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'play' || newData.val() === 'done' || newData.val() === 'closed'"
        },
        "players": {
          "$h": {
            ".write": "(auth != null && root.child('links').child($h).child(auth.uid).exists() && !root.child('bans').child($h).exists() && (!newData.exists() || data.exists() || (!data.parent().parent().child('kicked').child($h).exists() && !root.child('blocks').child(data.parent().parent().child('hostHk').val()).child($h).exists() && (data.parent().parent().child('state').val() === 'lobby' || data.parent().parent().child('members').child($h).exists())))) && root.child('access').child(auth.uid).child('until').val() > now",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 31",
            "team": {
              ".validate": "newData.val() === 'A' || newData.val() === 'B'"
            }
          }
        },
        "in": {
          "$k": {
            "$h": {
              ".write": "(auth != null && root.child('links').child($h).child(auth.uid).exists() && !root.child('bans').child($h).exists() && !data.exists() && data.parent().parent().parent().child('players').child($h).exists() && data.parent().parent().parent().child('state').val() === 'play') && root.child('access').child(auth.uid).child('until').val() > now"
            }
          }
        },
        "rx": {
          "$id": {
            ".write": "(auth != null && !data.exists() && newData.child('hk').isString() && root.child('links').child(newData.child('hk').val()).child(auth.uid).exists() && data.parent().parent().child('players').child(newData.child('hk').val()).exists()) && root.child('access').child(auth.uid).child('until').val() > now",
            ".validate": "newData.hasChildren(['hk', 'e', 'at']) && newData.child('e').isString() && newData.child('e').val().length <= 4 && newData.child('at').val() === now"
          }
        },
        "live": {
          "$h": {
            ".write": "auth != null && root.child('links').child($h).child(auth.uid).exists() && root.child('access').child(auth.uid).child('until').val() > now && data.parent().parent().child('players').child($h).exists()",
            ".validate": "newData.hasChildren(['pre', 'mv']) && newData.child('pre').isString() && newData.child('pre').val().length <= 24 && newData.child('mv').isString() && newData.child('mv').val().length <= 120"
          }
        }
      }
    },
    "blocks": {
      "$h": {
        ".read": "auth != null && root.child('access').child(auth.uid).child('until').val() > now",
        "$other": {
          ".write": "(auth != null && root.child('links').child($h).child(auth.uid).exists()) && root.child('access').child(auth.uid).child('until').val() > now",
          ".validate": "newData.val() === true"
        },
        ".write": "(root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true) && !newData.exists()"
      }
    },
    "reports": {
      "$id": {
        ".write": "(auth != null && !data.exists() && newData.child('by').isString() && root.child('links').child(newData.child('by').val()).child(auth.uid).exists()) || ((root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true) && !newData.exists())",
        ".validate": "newData.hasChildren(['by', 'target', 'at']) && newData.child('target').isString() && newData.child('at').val() === now && (!newData.child('reason').exists() || (newData.child('reason').isString() && newData.child('reason').val().length <= 200))"
      },
      ".read": "(root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true)",
      ".indexOn": [
        "at"
      ]
    },
    "access": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['until']) && newData.child('until').isNumber() && ((newData.child('day').isString() && newData.child('code').isString() && !newData.child('admin').exists() && root.child('gate').child(newData.child('day').val()).child(newData.child('code').val()).child('from').val() <= now && root.child('gate').child(newData.child('day').val()).child(newData.child('code').val()).child('to').val() > now && newData.child('until').val() === root.child('gate').child(newData.child('day').val()).child(newData.child('code').val()).child('to').val()) || (newData.child('admin').val() === true && newData.child('hk').isString() && root.child('admins').child(newData.child('hk').val()).val() === true && root.child('links').child(newData.child('hk').val()).child(auth.uid).exists() && newData.child('until').val() <= now + 86400000))"
      }
    },
    "admins": {
      "$h": {
        ".read": "auth != null",
        ".write": "(root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true)",
        ".validate": "newData.val() === true && root.child('players').child($h).exists()"
      },
      ".read": "auth != null"
    },
    "gate": {
      "$day": {
        "$code": {
          ".read": "auth != null",
          ".write": "(root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true)",
          ".validate": "newData.hasChildren(['from', 'to']) && newData.child('from').isNumber() && newData.child('to').isNumber() && $code.length === 4"
        }
      }
    },
    "gateAdmin": {
      ".read": "(root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true)",
      ".write": "(root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true)"
    },
    "online": {
      ".read": "auth != null && root.child('access').child(auth.uid).child('until').val() > now",
      "$h": {
        ".write": "auth != null && root.child('links').child($h).child(auth.uid).exists() && (root.child('access').child(auth.uid).child('until').val() > now || !newData.exists())",
        ".validate": "newData.hasChildren(['name', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 31 && newData.child('at').val() === now"
      }
    },
    "invites": {
      "$t": {
        ".read": "auth != null && root.child('links').child($t).child(auth.uid).exists()",
        "$f": {
          ".write": "auth != null && ((!newData.exists() && root.child('links').child($t).child(auth.uid).exists()) || (newData.exists() && root.child('links').child($f).child(auth.uid).exists() && root.child('access').child(auth.uid).child('until').val() > now && $f !== $t && root.child('settings').child('crossTable').val() !== false && !root.child('bans').child($f).exists() && root.child('players').child($t).child('invites').val() === true && !root.child('blocks').child($t).child($f).exists() && !root.child('blocks').child($f).child($t).exists() && (!data.exists() || data.child('at').val() < now - 600000)))",
          ".validate": "newData.hasChildren(['room', 'game', 'name', 'at']) && newData.child('room').isString() && newData.child('room').val().length === 4 && newData.child('game').isString() && newData.child('game').val().length <= 20 && newData.child('name').isString() && newData.child('name').val().length <= 31 && newData.child('at').val() === now"
        }
      }
    },
    "bans": {
      "$h": {
        ".read": "auth != null",
        ".write": "(root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true)",
        ".validate": "newData.hasChildren(['at','by']) && newData.child('at').val() === now && newData.child('by').isString() && (!newData.child('reason').exists() || (newData.child('reason').isString() && newData.child('reason').val().length <= 200))"
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "(root.child('access').child(auth.uid).child('admin').val() === true && root.child('access').child(auth.uid).child('until').val() > now && root.child('admins').child(root.child('access').child(auth.uid).child('hk').val()).val() === true)",
      "crossTable": {
        ".validate": "newData.isBoolean()"
      },
      "$other": {
        ".validate": false
      }
    },
    "rezKeys": {
      ".read": "auth != null && root.child('rezAccess').child(auth.uid).child('role').val() === 'edit' && root.child('rezKeys').child('edit').child(root.child('rezAccess').child(auth.uid).child('key').val()).exists()",
      ".write": "auth != null && root.child('rezAccess').child(auth.uid).child('role').val() === 'edit' && root.child('rezKeys').child('edit').child(root.child('rezAccess').child(auth.uid).child('key').val()).exists()",
      "$role": {
        ".validate": "$role === 'edit' || $role === 'view'",
        "$key": {
          ".validate": "newData.val() === true && $key.length >= 20"
        }
      }
    },
    "rezAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['role','key']) && newData.child('role').isString() && newData.child('key').isString() && newData.parent().parent().child('rezKeys').child(newData.child('role').val()).child(newData.child('key').val()).exists()",
        "role": {
          ".validate": "newData.val() === 'edit' || newData.val() === 'view'"
        },
        "key": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rez": {
      ".read": "auth != null && root.child('rezKeys').child(root.child('rezAccess').child(auth.uid).child('role').val()).child(root.child('rezAccess').child(auth.uid).child('key').val()).exists()",
      ".write": "auth != null && root.child('rezAccess').child(auth.uid).child('role').val() === 'edit' && root.child('rezKeys').child('edit').child(root.child('rezAccess').child(auth.uid).child('key').val()).exists()",
      "$day": {
        ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "$rid": {
          ".validate": "newData.hasChildren(['table','name','size','time','status','by','at'])",
          "table": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "size": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60"
          },
          "time": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-2][0-9]:[0-5][0-9]$/)"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "status": {
            ".validate": "newData.val() === 'bekliyor' || newData.val() === 'geldi'"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rezPhone": {
      ".read": "auth != null && root.child('rezAccess').child(auth.uid).child('role').val() === 'edit' && root.child('rezKeys').child('edit').child(root.child('rezAccess').child(auth.uid).child('key').val()).exists()",
      ".write": "auth != null && root.child('rezAccess').child(auth.uid).child('role').val() === 'edit' && root.child('rezKeys').child('edit').child(root.child('rezAccess').child(auth.uid).child('key').val()).exists()",
      "$day": {
        ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "$rid": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        }
      }
    },
    "rezLayout": {
      ".read": "auth != null && root.child('rezKeys').child(root.child('rezAccess').child(auth.uid).child('role').val()).child(root.child('rezAccess').child(auth.uid).child('key').val()).exists()",
      ".write": "auth != null && root.child('rezAccess').child(auth.uid).child('role').val() === 'edit' && root.child('rezKeys').child('edit').child(root.child('rezAccess').child(auth.uid).child('key').val()).exists()",
      ".validate": "newData.hasChildren(['items'])"
    }
  }
}